{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbs-navigation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "none" にしておくと未マッチのパスは Worker に流れる。
    // フロントを SPA ビルドに差し替える時点で "single-page-application" +
    // run_worker_first: ["/api/*"] に変更する (T-57)。
    "not_found_handling": "none"
  },
  // T-34 天気キャッシュ。Open-Meteo の応答を 30分ぶん保持する。
  // 落ちても degraded.weather=true で動くので、必須バインディングではない。
  "kv_namespaces": [
    { "binding": "CACHE", "id": "42d6d220970b44c0932ad263d1d3667f" }
  ],

  // T-37 埋め込み生成 / T-71 理由生成
  "ai": { "binding": "AI" },

  // T-36 自然文検索の索引。bge-m3 に合わせて 1024次元 / cosine で作成済み。
  // 中身は D1 から再生成できる (POST /api/admin/reindex)。
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "urbs-places" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo_outings",
      "database_id": "f6d47cd4-3269-46b4-bdb4-fb757d276255"
    }
  ],
  "observability": { "enabled": true }
}
