{
  "name": "urbs-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check:code": "vp check",
    "cf-typegen": "wrangler types",
    "db:schema": "wrangler d1 execute tokyo_outings --remote --file=db/schema.sql",
    "db:schema:local": "wrangler d1 execute tokyo_outings --local --file=db/schema.sql",
    "db:seed": "wrangler d1 execute tokyo_outings --remote --file=db/seed.sql",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check": "npm run typecheck && npm run check:code && npm run check:fixtures && npm run check:normalized",
    "etl:catalog": "node etl/00-catalog.mjs",
    "etl:encode": "node etl/02-encode.mjs",
    "etl:normalize": "node etl/03-normalize.mjs",
    "etl": "npm run etl:encode && npm run etl:normalize && npm run check:normalized && npm run etl:station-modes && npm run etl:select && npm run etl:emit",
    "check:normalized": "node scripts/check-normalized.mjs",
    "etl:select": "node etl/04-select.mjs",
    "etl:station-modes": "node etl/06-station-modes.mjs",
    "etl:emit": "node etl/05-emit-sql.mjs",
    "check:api": "node scripts/check-api.mjs",
    "reindex": "node scripts/reindex.mjs"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0-rc.1",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  }
}
